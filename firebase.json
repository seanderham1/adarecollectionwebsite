        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/the-captains>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/putters-way",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/putters-way>; rel=\"canonical\""
          }
        ]
      },
      {
