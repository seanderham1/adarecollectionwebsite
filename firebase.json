          }
        ]
      },
      {
        "source": "/privacy",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/privacy>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/terms",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/terms>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
