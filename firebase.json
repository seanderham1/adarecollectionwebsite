          }
        ]
      },
      {
        "source": "/property/darrira-house",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/darrira-house>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/croagh-house",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/croagh-house>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/parkview-house",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/parkview-house>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/dunes-lodge",
        "headers": [
          {
