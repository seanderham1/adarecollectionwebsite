{
  "functions": { "source": "functions" },
  "hosting": {
    "site": "theadarecollection-site",
    "public": "dist/public",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/hillview-videos/**",
      "**/Hillview House 1 Video Assets/**",
      "**/Portland House 2 Video Assets/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ]
  }
}