        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/the-fairways>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/cragleigh-house",
        "headers": [
          {
            "key": "Link",
