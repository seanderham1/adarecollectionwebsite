{
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "site": "theadarecollection-site",
    "public": "dist/public",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/hillview-videos/**",
      "**/Hillview House 1 Video Assets/**",
      "**/Portland House 2 Video Assets/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/properties",
        "destination": "/_prerender/properties.html"
      },
      {
        "source": "/about",
        "destination": "/_prerender/about.html"
      },
      {
        "source": "/contact",
        "destination": "/_prerender/contact.html"
      },
      {
        "source": "/faq",
        "destination": "/_prerender/faq.html"
      },
      {
        "source": "/privacy",
        "destination": "/_prerender/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/_prerender/terms.html"
      },
      {
        "source": "/property/rangeview",
        "destination": "/_prerender/property__rangeview.html"
      },
      {
        "source": "/property/the-captains",
        "destination": "/_prerender/property__the-captains.html"
      },
      {
        "source": "/property/putters-way",
        "destination": "/_prerender/property__putters-way.html"
      },
      {
        "source": "/property/the-first-tee",
        "destination": "/_prerender/property__the-first-tee.html"
      },
      {
        "source": "/property/the-fairways",
        "destination": "/_prerender/property__the-fairways.html"
      },
      {
        "source": "/property/cragleigh-house",
        "destination": "/_prerender/property__cragleigh-house.html"
      },
      {
        "source": "/property/darrira-house",
        "destination": "/_prerender/property__darrira-house.html"
      },
      {
        "source": "/property/croagh-house",
        "destination": "/_prerender/property__croagh-house.html"
      },
      {
        "source": "/property/parkview-house",
        "destination": "/_prerender/property__parkview-house.html"
      },
      {
        "source": "/property/dunes-lodge",
        "destination": "/_prerender/property__dunes-lodge.html"
      },
      {
        "source": "/property/hillview-house",
        "destination": "/_prerender/property__hillview-house.html"
      },
      {
        "source": "/property/portland-house",
        "destination": "/_prerender/property__portland-house.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/properties",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/properties>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/about",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/about>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/contact",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/contact>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/faq",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/faq>; rel=\"canonical\""
          }
        ]
      },
      {
        "source": "/property/rangeview",
        "headers": [
          {
            "key": "Link",
            "value": "<https://theadarecollection.com/property/rangeview>; rel=\"canonical\""
          }
        ]
      },
      {
