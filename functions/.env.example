# Used by Firebase Functions Emulator only (`firebase emulators:start --only functions`).
# Production uses Secret Manager (`GMAIL_APP_PASSWORD`); never commit `.env`.

GMAIL_APP_PASSWORD=

# Optional: if your Google Workspace *login* is not info@theadarecollection.ie but that
# inbox is configured as Send mail as, set this to your primary mailbox (matches App Password owner).
GMAIL_SMTP_USER=

# Google Sheets (contact form append). Production: share the sheet with the
# Cloud Function *runtime* service account (ADC — no key). Set spreadsheet id + range.
# Optional: paste service account JSON here for local emulator only if you use a key.
CONTACT_SHEET_SPREADSHEET_ID=
CONTACT_SHEET_RANGE=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=